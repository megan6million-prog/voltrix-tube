# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=Voltrix
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-64-char-string-in-production

# ── Database ───────────────────────────────────────────────────────────────
# Overridden by docker-compose for local dev
DATABASE_URL=postgresql+asyncpg://voltrix_admin:voltrix_dev_password_change_me@localhost:5432/voltrix

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS ───────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=991514087781

# ── S3 Buckets (fill after CloudFormation deploy) ─────────────────────────
S3_RAW_UPLOADS=voltrix-raw-uploads-prod-991514087781
S3_PROCESSED_VIDEOS=voltrix-processed-videos-prod-991514087781
S3_THUMBNAILS=voltrix-thumbnails-prod-991514087781
S3_SOUNDS=voltrix-sounds-prod-991514087781
S3_CAPTIONS=voltrix-captions-prod-991514087781
S3_FRONTEND=voltrix-frontend-prod-991514087781
S3_DATA_LAKE=voltrix-data-lake-prod-991514087781
S3_EXPORTS=voltrix-exports-prod-991514087781

# ── CloudFront (fill after deploy) ────────────────────────────────────────
CLOUDFRONT_DOMAIN=https://placeholder.cloudfront.net

# ── Cognito (fill after deploy) ───────────────────────────────────────────
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_REGION=eu-west-1

# ── MediaConvert (fill after deploy) ──────────────────────────────────────
MEDIACONVERT_ENDPOINT=https://XXXXXXXXXX.mediaconvert.eu-west-1.amazonaws.com
MEDIACONVERT_ROLE_ARN=arn:aws:iam::991514087781:role/voltrix-mediaconvert-role

# ── SQS Queues (fill after CloudFormation deploy) ─────────────────────────
SQS_PAYMENT_WEBHOOKS=https://sqs.eu-west-1.amazonaws.com/991514087781/voltrix-payment-webhooks
SQS_UPLOAD_JOBS=https://sqs.eu-west-1.amazonaws.com/991514087781/voltrix-upload-jobs
SQS_NOTIFICATIONS=https://sqs.eu-west-1.amazonaws.com/991514087781/voltrix-notifications
SQS_MISSING_CONTENT=https://sqs.eu-west-1.amazonaws.com/991514087781/voltrix-missing-content

# ── Kinesis ────────────────────────────────────────────────────────────────
KINESIS_EVENTS_STREAM=voltrix-events

# ── MTN MoMo (sandbox keys from momodeveloper.mtn.com) ────────────────────
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_COLLECTION_PRIMARY_KEY=your-collection-primary-key
MTN_MOMO_COLLECTION_SECRET=your-base64-encoded-secret
MTN_MOMO_DISBURSEMENT_PRIMARY_KEY=your-disbursement-primary-key
MTN_MOMO_DISBURSEMENT_SECRET=your-disbursement-secret
MTN_MOMO_ENVIRONMENT=sandbox

# ── Airtel Money (sandbox keys from developer.airtel.africa) ──────────────
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=your-airtel-client-id
AIRTEL_CLIENT_SECRET=your-airtel-client-secret
AIRTEL_ENVIRONMENT=sandbox

# ── Coinbase Commerce (commerce.coinbase.com) ──────────────────────────────
COINBASE_API_KEY=your-coinbase-api-key
COINBASE_WEBHOOK_SECRET=your-coinbase-webhook-secret

# ── Platform Fees ──────────────────────────────────────────────────────────
AD_REVENUE_CREATOR_PCT=55.0
TIP_PLATFORM_CUT_PCT=10.0
MEMBERSHIP_PLATFORM_CUT_PCT=25.0
PPV_PLATFORM_CUT_PCT=30.0
MOVIE_REFERRAL_PCT=10.0
SPORTS_REFERRAL_PCT=8.0

# ── Wallet Limits ──────────────────────────────────────────────────────────
MIN_WALLET_TOPUP_UGX=1000
MAX_WALLET_BALANCE_UGX=5000000
MIN_CREATOR_PAYOUT_UGX=50000
EARNINGS_HOLD_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:19006"]
